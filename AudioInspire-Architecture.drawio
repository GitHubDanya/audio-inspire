        </mxCell>
        <mxCell id="TjZt2FF7NNkTal9uvKal-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Get audio file&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Convert audio file to .wav&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Use Fast-Fourier Transform to extract note frequencies using NAudio&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Keep raising noise floor until at least 90% of notes are recognized&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Fill in empty notes by extending the latest note played until a change&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Package bpm, note length and sequence into a JSON payload&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Return the payload&lt;/div&gt;" vertex="1">
          <mxGeometry height="270" width="210" x="40" y="440" as="geometry" />
        </mxCell>
        <mxCell id="TjZt2FF7NNkTal9uvKal-16" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Get a sequence JSON Data File and a phrase count parameter n&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Break the sequence into phrases of n notes and possible continuations&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Compile a transition matrix based on the returned phrases&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Run a markov chain on the transition matrix and stream results into a new sequence JSON data file&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Return the payload&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="210" x="270" y="440" as="geometry" />
        </mxCell>
