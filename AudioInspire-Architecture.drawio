        <mxCell id="TjZt2FF7NNkTal9uvKal-9" parent="TjZt2FF7NNkTal9uvKal-8" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div align=&quot;left&quot;&gt;{&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&amp;nbsp; &quot;bpm&quot;: bpm (int),&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&amp;nbsp; &quot;note_length&quot;: fraction of bar (float),&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;&amp;nbsp; &quot;sequence&quot;: sequence of notes (e.g. AAAAGGGGDDDDDDDD) (string)&lt;/div&gt;&lt;div align=&quot;left&quot;&gt;}&lt;/div&gt;" vertex="1">
